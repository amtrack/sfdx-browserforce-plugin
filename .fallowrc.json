{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["bin/*.js", "src/commands/**/*.ts"],
  "supportEntry": ["scripts/**/*.ts", "test/**/*.ts"],
  "ignorePatterns": ["docs/**"],
  "ignoreDependencies": [
    "@jsforce/jsforce-node",
    "@oclif/core",
    "@salesforce/core",
    "@salesforce/dev-scripts",
    "@salesforce/prettier-config"
  ],
  "duplicates": {
    "ignore": ["test/**/*.ts", "src/**/*.e2e-spec.ts"]
  },
  "rules": {}
}
