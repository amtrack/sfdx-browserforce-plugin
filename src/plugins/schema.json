      "type": "object",
      "properties": {
        "certificates": {
          "default": [],
          "title": "Self-Signed Certificates",
          "type": "array",
          "items": {
            "$ref": "#/definitions/certificate"
          }
        },
        "importFromKeystore": {
          "default": [],
          "title": "Import Certificate from Keystore",
          "type": "array",
          "items": {
            "$ref": "#/definitions/keystore"
          }
        }
      },
      "title": "Certificate and Key Management"
    },
    "certificate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "exportable": {
          "type": "boolean"
        },
        "keysize": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["name", "label"]
    },
    "keystore": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Optional new name of the certificate. WARNING: Only use this to change the case of the certificate name as the imported name is lowercase by default."
        },
        "filePath": {
          "type": "string",
          "description": "Relative path from current working directory"
        },
        "password": {
          "type": "string"
        }
      },
      "required": ["name", "filePath"]
    },
    "authenticationConfiguration": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "The visible name of the authentication service"
              },
              "authProviderApiName": {
                "type": "string",
                "description": "The DeveloperName of the AuthProvider (alternative to label for matching)"
              },
              "enabled": {
                "type": "boolean",
                "description": "True to enable, false to disable"
              }
            },
            "oneOf": [
              {
                "required": ["label", "enabled"]
              },
              {
                "required": ["authProviderApiName", "enabled"]
              },
              {
                "required": ["label", "authProviderApiName", "enabled"]
              }
            ]
          },
          "description": "List of Authentication Services to configure under My Domain, each with desired enabled state",
          "default": []
        }
      },
      "required": ["services"],
      "title": "Authentication Configuration"
    },
    "serviceChannel": {
      "type": "object",
      "properties": {
        "serviceChannelDeveloperName": {
          "type": "string",
